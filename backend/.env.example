# ==============================================================================
# LedgerAgent 後端環境設定範本
# 複製為 .env 後即可依需求調整
# ==============================================================================

# 資料庫連線 (預設連接 docker-compose.yml 啟動的 PostgreSQL)
DATABASE_URL=postgresql+psycopg://ledger:ledger_dev_password@localhost:5432/ledger_agent

# AI 模型供應商：mock | gemini | openai
# - mock: 不需 API Key，適合先測試系統流程與學習架構
# - gemini: 使用 Google Gemini 多模態模型 (推薦，原生支援圖片/PDF)
# - openai: 使用 OpenAI 或相容 API (含 Ollama / OpenRouter)
LLM_PROVIDER=mock

# Google Gemini 設定 (當 LLM_PROVIDER=gemini 時必填)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible 設定 (當 LLM_PROVIDER=openai 時必填)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 若接 Ollama 本地模型可設為 http://localhost:11434/v1
OPENAI_BASE_URL=

# 檔案路徑設定（相對於 backend 目錄）
COMPANIES_DIR=../companies
UPLOAD_DIR=./uploads

# CORS 允許來源 (React Vite 預設埠號)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
